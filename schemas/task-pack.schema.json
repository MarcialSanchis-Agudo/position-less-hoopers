{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PLH TaskPack",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskPackId",
    "version",
    "seedPath",
    "activeContractPath",
    "grader",
    "evidenceRefTemplate",
    "contracts",
    "scenarioFiles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskPackId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "domain": { "type": ["string", "null"] },
    "seedPath": { "type": "string", "minLength": 1 },
    "activeContractPath": { "type": "string", "minLength": 1 },
    "grader": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRefTemplate": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\{version\\}"
    },
    "contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "scenarioFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

