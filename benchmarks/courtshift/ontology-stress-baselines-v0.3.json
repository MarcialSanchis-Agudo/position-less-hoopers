{
  "schemaVersion": 1,
  "ontologySetId": "plh-ontology-stress-baselines-v0.3",
  "status": "frozen-before-ontology-stress-task-authoring",
  "createdAfter": "plh-paper-eval-set-v0.2",
  "purpose": "Freeze a strong predefined-role ontology and candidate worker pool before authoring the new ontology-stress TaskPacks.",
  "baselineIds": [
    "B0",
    "B1",
    "B2",
    "B3",
    "P"
  ],
  "baselineDefinitions": {
    "B0": "One strong generalist with broad bounded context.",
    "B1": "One fixed implementation owner for every state.",
    "B2": "Fixed specialist-role owners under the frozen role ontology.",
    "B3": "Dynamic worker assignment, but the Need/function must be expressed as one role from the frozen ontology.",
    "P": "State-derived Need may reference any authoritative context dimensions exposed by the task state, then uses the same candidate pool and matcher as B3."
  },
  "predefinedRoles": {
    "implementer": {
      "objective": "Modify implementation code to satisfy known behavior.",
      "requiredCapabilities": [
        "implement"
      ],
      "contextRefs": [
        "implementation"
      ]
    },
    "contract_interpreter": {
      "objective": "Interpret changed requirements and adapt implementation.",
      "requiredCapabilities": [
        "implement",
        "analyze_contract"
      ],
      "contextRefs": [
        "contract"
      ]
    },
    "verifier": {
      "objective": "Diagnose failed evidence and verify a candidate repair.",
      "requiredCapabilities": [
        "verify"
      ],
      "contextRefs": [
        "evidence",
        "tests"
      ]
    },
    "runtime_investigator": {
      "objective": "Diagnose behavior from runtime traces and operational symptoms.",
      "requiredCapabilities": [
        "diagnose"
      ],
      "contextRefs": [
        "runtime_trace"
      ]
    },
    "dependency_diagnostician": {
      "objective": "Diagnose ordering or dependency failures.",
      "requiredCapabilities": [
        "diagnose"
      ],
      "contextRefs": [
        "dependency_graph"
      ]
    },
    "recovery_planner": {
      "objective": "Plan a safe recovery or rollback from a known bad state.",
      "requiredCapabilities": [
        "recover"
      ],
      "contextRefs": [
        "rollback_history"
      ]
    },
    "conflict_resolver": {
      "objective": "Resolve known concurrent-state conflicts.",
      "requiredCapabilities": [
        "reconcile"
      ],
      "contextRefs": [
        "concurrent_state"
      ]
    }
  },
